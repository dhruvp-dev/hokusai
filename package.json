{
  "name": "hokusai-ss",
  "version": "0.2.1",
  "description": "Beautiful website screenshots. Zero configuration.",
  "author": "Dhruv",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dhruvp-dev/hokusai.git"
  },
  "bugs": {
    "url": "https://github.com/dhruvp-dev/hokusai/issues"
  },
  "homepage": "https://github.com/dhruvp-dev/hokusai#readme",
  "keywords": [
    "screenshot",
    "playwright",
    "sharp",
    "portfolio",
    "automation",
    "webp",
    "static-site",
    "thumbnails"
  ],
  "type": "module",
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "bin": {
    "hokusai-ss": "src/cli/index.js",
    "hokusai": "src/cli/index.js"
  },
  "scripts": {
    "start": "node src/cli/index.js",
    "screenshot": "node src/cli/index.js",
    "ext:build": "pnpm --filter hokusai-extension build",
    "ext:watch": "pnpm --filter hokusai-extension watch",
    "ext:package": "pnpm --filter hokusai-extension package",
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix"
  },
  "dependencies": {
    "playwright": "^1.45.0",
    "serve-handler": "^6.1.8",
    "sharp": "^0.35.5"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "globals": "^17.14.0"
  }
}

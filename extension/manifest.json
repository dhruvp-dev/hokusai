{
  "manifest_version": 3,
  "name": "Hokusai",
  "version": "0.1.0",
  "description": "Beautiful website screenshots. Zero configuration.",
  "browser_specific_settings": {
    "gecko": {
      "id": "hokusai@dhruvp-dev.github.io",
      "strict_min_version": "115.0",
      "data_collection_permissions": { "required": ["none"] }
    }
  },
  "permissions": [
    "activeTab",
    "tabs",
    "storage",
    "downloads",
    "clipboardWrite",
    "contextMenus"
  ],
  "commands": {
    "capture-visible": {
      "suggested_key": { "default": "Ctrl+Shift+H" },
      "description": "Capture current page with Hokusai"
    }
  },
  "action": {
    "default_popup": "popup/index.html",
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "32": "assets/icons/icon-32.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "background": {
    "scripts": ["background/background.bundle.js"]
  },
  "content_scripts": [{
    "matches": ["<all_urls>"],
    "js": ["content/content.bundle.js"],
    "run_at": "document_idle"
  }],
  "icons": {
    "16": "assets/icons/icon-16.png",
    "32": "assets/icons/icon-32.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
